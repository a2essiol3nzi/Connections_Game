digraph Server {
  rankdir=LR;
  graph [bgcolor=white, fontname="Inter, Arial, Helvetica, sans-serif", splines=true, dpi=96,
         nodesep=1.2, ranksep=1.4, pad="0.6,0.6", labelloc="t"];
  node  [fontname="Inter, Arial, Helvetica, sans-serif", shape=box, style="rounded,filled",
         fontsize=12, margin=0.25];
  edge  [fontname="Inter, Arial, Helvetica, sans-serif", fontsize=10, color="#555555",
         arrowsize=0.8, minlen=2, labeldistance=2.5];

  // ===== THREAD 1 · main: wiring + acceptor =====
  subgraph cluster_main {
    label="THREAD 1 · main (1)"; fontsize=13; fontcolor="#7b4a0e"; style="rounded,filled";
    fillcolor="#fdf6e3"; color="#d68910";
    Main   [label="ServerMain\n(main()) wiring", fillcolor="#ffffff", color="#d68910", fontcolor="#7b4a0e"];
    Accept [label="ConnectionAcceptor\naccept() loop\n→ pool.submit(ClientHandler)", fillcolor="#ffffff", color="#d68910", fontcolor="#111827"];
    Main -> Accept [label="run() (stesso thread)", style=dashed, color="#999999"];
  }

  // ===== THREAD 2 · scheduler =====
  subgraph cluster_sched {
    label="THREAD 2 · scheduler (1)"; fontsize=13; fontcolor="#92400e"; style="rounded,filled";
    fillcolor="#fdf6e3"; color="#d97706";
    Sched [label="GameScheduler\nsleep → finalizeGame → persist\n→ notifier.notifyEnd → rotate", fillcolor="#ffffff", color="#d97706", fontcolor="#111827"];
  }

  // ===== THREAD 3 · shutdown hook =====
  subgraph cluster_hook {
    label="THREAD 3 · shutdown hook (1)"; fontsize=13; fontcolor="#92400e"; style="rounded,filled";
    fillcolor="#fdf6e3"; color="#d97706";
    Hook [label="ShutdownHook (JVM)\nSIGTERM/SIGINT\nusers.persist() + persistHistory()", fillcolor="#ffffff", color="#d97706", fontcolor="#111827"];
  }

  // ===== THREAD POOL: N ClientHandler (on-demand) =====
  subgraph cluster_pool {
    label="THREAD POOL · 0..N ClientHandler"; fontsize=13; fontcolor="#075985"; style="rounded,filled";
    fillcolor="#e0f2fe"; color="#0284c7";
    Pool [label="ThreadPool (on-demand)\ncore 0 → max N · keep-alive 10s\nSynchronousQueue · AbortPolicy\n(rifiuta se saturo)\n1 connessione persistente / handler\n(gestisce tutte le operazioni)", fillcolor="#ffffff", color="#0284c7", fontcolor="#111827"];
  }

  // ===== OGGETTO CONDIVISO (stato) + notifier =====
  subgraph cluster_shared {
    label="OGGETTO CONDIVISO tra i thread (lock)"; fontsize=12; fontcolor="#166534";
    style="rounded,filled,dashed"; fillcolor="#f0fdf4"; color="#16a34a";
    GM     [label="GameManager\ncurrent (volatile) · history (CHM) · onlineUsers\nnextRoundId (Atomic) · finalize idempotente\nsubmit lock-free · rotate sync", fillcolor="#ffffff", color="#16a34a", fontcolor="#111827"];
    Store  [label="UserStore\nbyId · nameToId (CHM)\npersist event-driven su ioLock (No timer)", fillcolor="#ffffff", color="#16a34a", fontcolor="#111827"];
    Reg    [label="UdpRegistry\nuserId → addr:port (CHM)", fillcolor="#ffffff", color="#16a34a", fontcolor="#111827"];
    Notif  [label="UdpNotifier\n(un socket per notifyEnd, poi close)", fillcolor="#ffffff", color="#16a34a", fontcolor="#111827"];
    GM -> Store [label="stats update"];
    GM -> Reg   [label="logoutUser (pulisce)"];
  }

  // ===== archi: main / pool (Connessioni) =====
  Accept -> Pool [label="pool.submit()"];
  Pool   -> GM    [label="reg.log / login / logout\nsubmitProposal / info / stats\nleaderboard / playerStats"];
  Pool   -> Store [label="register / login\nupdateCredentials / getById"];
  Pool   -> Reg   [label="register(body) endpoint"];

  // ===== archi: scheduler / hook (ciclo di vita + persistenza) =====
  Sched  -> GM    [label="finalizeGame / rotate"];
  Sched  -> Store [label="persist() (stats post-finalize)"];
  Sched  -> Notif [label="notifyEnd(...)"];
  Hook   -> Store [label="persist()"];
  Hook   -> GM    [label="persistHistory()"];

  // ===== notifier: usa registry =====
  Notif -> Reg [label="getEndpoint()"];

  // ===== avvio thread =====
  Main -> Sched [style=dotted, label="start"];
  Main -> Hook  [style=dotted, label="addShutdownHook"];
  Main -> Pool  [style=dotted, label="newThreadPoolExecutor", constraint=false];
}